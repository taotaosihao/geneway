FROM postgres:17-bookworm AS postgres

FROM node:22.21.1-bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libpq5 libldap-2.5-0 libgssapi-krb5-2 liblz4-1 libzstd1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=postgres /usr/lib/postgresql/17/ /usr/lib/postgresql/17/
COPY --from=postgres /usr/share/postgresql/17/ /usr/share/postgresql/17/

ENV PATH="/usr/lib/postgresql/17/bin:/usr/local/bin:${PATH}"
WORKDIR /workspace
